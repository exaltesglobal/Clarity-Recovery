{
  "expo": {
    "name": "Clarity Recovery",
    "slug": "clarity-recovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exaltesglobal.clarityrecovery"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.exaltesglobal.clarityrecovery"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "clarity",
    "owner": "exaltes-global-private-limited",
    "extra": {
      "eas": {
        "projectId": "c880a66c-7c71-4d63-9802-616bd56a31d7"
      }
    }
  }
}
